      "get": {
        "operationId": "getProject",
        "tags": [
          "projects"
        ],
        "summary": "Read 100 visible cards and a next cursor",
        "description": "Requires an unrestricted personal token and current organization membership. Board creation/settings/deletion require organization ownership and admin scope; card mutations require write scope. Hidden repository cards are never returned. Filters are applied after repository visibility and before the 100-card page limit. Sorts are ascending with unset priority/date last and issue ID ties. next_cursor is opaque and bound to the board and effective criteria; after/next remain available for id sort. A saved view permits only view, cursor or after. Overdue means an open issue with target_date before today in UTC. Progress excludes unreadable relations. can_manage and view can_edit include token scope.",
        "security": [
          {
            "token": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Revision changed; reload before retrying"
          },
          "422": {
            "description": "Invalid input or project resource limit"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repository",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "column",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "none",
                "urgent",
                "high",
                "normal",
                "low"
              ]
            }
          },
          {
            "name": "iteration",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "0 selects cards without an iteration"
            }
          },
          {
            "name": "overdue",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "layout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "board",
                "table"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "priority",
                "target_date"
              ]
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
