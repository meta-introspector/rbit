{
  "paths": {
    "/repos/{owner}/{repo}/search/code": {
      "get": {
        "summary": "Search default-branch code (literal, case-sensitive, bounded)",
        "operationId": "searchRepositoryCode",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commit, matches (path, line, snippet, html_url), truncated and skipped_files. At most 100 matching lines.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "commit",
                    "matches",
                    "truncated",
                    "skipped_files"
                  ],
                  "properties": {
                    "commit": {
                      "type": "string"
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "skipped_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "matches": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "line",
                          "snippet",
                          "html_url"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "line": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "snippet": {
                            "type": "string",
                            "maxLength": 400
                          },
                          "html_url": {
                            "type": "string",
                            "format": "uri"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Repository not visible"
          },
          "503": {
            "description": "Search capacity exhausted"
          },
          "422": {
            "description": "Invalid or missing query or oversized filter"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
