              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requested evidence"
          },
          "403": {
            "description": "Insufficient upload or administration authority"
          },
          "404": {
            "description": "Repository or security evidence is not visible"
          },
          "409": {
            "description": "Already completed, retention limit or changed configuration"
          },
          "413": {
            "description": "Report exceeds 1 MiB"
          },
          "422": {
            "description": "Unsupported or malformed SARIF/input"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/security/findings/{id}/dismissal": {
      "post": {
        "operationId": "dismissSecurityFinding",
        "summary": "Dismiss or reopen a finding with an audit note",
        "tags": [
          "Security"
        ],
        "description": "Repository writers only; hidden findings return 404. Mutations require repository administration and an unrestricted admin-scope token. Scan initiation/completion also accepts live task tokens from the explicitly configured trusted default-branch workflow.",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requested evidence"
          },
          "403": {
            "description": "Insufficient upload or administration authority"
          },
          "404": {
            "description": "Repository or security evidence is not visible"
          },
          "409": {
            "description": "Already completed, retention limit or changed configuration"
          },
          "413": {
            "description": "Report exceeds 1 MiB"
          },
          "422": {
            "description": "Unsupported or malformed SARIF/input"
          },
          "204": {
            "description": "Dismissal state updated and audited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": [
                      "false_positive",
                      "accepted_risk",
                      "used_in_tests",
                      "reopen"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        }
      }
    },
    "/repos/{owner}/{repo}/security/automation": {
      "get": {
        "operationId": "securityAutomation",
        "summary": "Read native scanning settings",
        "tags": [
          "Security"
        ],
        "description": "Findings and inventory are visible only to repository writers. Configuration and proposals require current repository administration and an unrestricted admin-scope token. Native scan requests also accept the configured trusted default-branch workflow task. Dependency scanning requires explicit permission to send public package names/versions to OSV/npm. Proposals inherit repository visibility and never merge automatically. Unsupported repairs return 422. Native result evidence cannot be supplied by the caller.",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requested evidence"
          },
          "403": {
            "description": "Insufficient upload or administration authority"
          },
          "404": {
            "description": "Repository or security evidence is not visible"
          },
          "409": {
            "description": "Already completed, retention limit or changed configuration"
          },
          "413": {
            "description": "Report exceeds 1 MiB"
          },
          "422": {
            "description": "Unsupported or malformed SARIF/input"
          }
        }
      },
      "put": {
        "operationId": "configureSecurityAutomation",
        "summary": "Opt in to native scans and package metadata disclosure",
        "tags": [
          "Security"
        ],
        "description": "Findings and inventory are visible only to repository writers. Configuration and proposals require current repository administration and an unrestricted admin-scope token. Native scan requests also accept the configured trusted default-branch workflow task. Dependency scanning requires explicit permission to send public package names/versions to OSV/npm. Proposals inherit repository visibility and never merge automatically. Unsupported repairs return 422. Native result evidence cannot be supplied by the caller.",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requested evidence"
          },
          "403": {
            "description": "Insufficient upload or administration authority"
          },
          "404": {
            "description": "Repository or security evidence is not visible"
          },
          "409": {
            "description": "Already completed, retention limit or changed configuration"
          },
          "413": {
            "description": "Report exceeds 1 MiB"
          },
          "422": {
            "description": "Unsupported or malformed SARIF/input"
          },
          "204": {
            "description": "Settings saved and prior native evidence invalidated"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "secrets": {
                    "type": "boolean",
                    "default": false
                  },
                  "dependencies": {
                    "type": "boolean",
                    "default": false
                  },
                  "package_network_consent": {
                    "type": "boolean",
                    "default": false
                  },
                  "require_secrets": {
                    "type": "boolean",
                    "default": false
                  },
                  "require_dependencies": {
                    "type": "boolean",
                    "default": false
                  },
                  "automatic_pull_requests": {
                    "type": "boolean",
                    "default": false
                  },
                  "minimum_severity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "workflow": {
                    "type": "string",
                    "maxLength": 1024
                  }
                },
                "required": [
                  "minimum_severity"
                ]
              }
            }
          }
        }
      }
    },
    "/repos/{owner}/{repo}/security/automation/scans": {
