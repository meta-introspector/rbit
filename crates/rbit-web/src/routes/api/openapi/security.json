{
  "paths": {
    "/repos/{owner}/{repo}/security/settings": {
      "get": {
        "operationId": "securitySettings",
        "summary": "Read scanner settings",
        "tags": [
          "Security"
        ],
        "description": "Repository writers only; hidden findings return 404. Mutations require repository administration and an unrestricted admin-scope token. Scan initiation/completion also accepts live task tokens from the explicitly configured trusted default-branch workflow.",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requested evidence"
          },
          "403": {
            "description": "Insufficient upload or administration authority"
          },
          "404": {
            "description": "Repository or security evidence is not visible"
          },
          "409": {
            "description": "Already completed, retention limit or changed configuration"
          },
          "413": {
            "description": "Report exceeds 1 MiB"
          },
          "422": {
            "description": "Unsupported or malformed SARIF/input"
          }
        }
      },
      "put": {
        "operationId": "configureSecurity",
        "summary": "Configure trusted scanner and merge gate",
        "tags": [
          "Security"
        ],
        "description": "Repository writers only; hidden findings return 404. Mutations require repository administration and an unrestricted admin-scope token. Scan initiation/completion also accepts live task tokens from the explicitly configured trusted default-branch workflow.",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requested evidence"
          },
          "403": {
            "description": "Insufficient upload or administration authority"
          },
          "404": {
            "description": "Repository or security evidence is not visible"
          },
          "409": {
            "description": "Already completed, retention limit or changed configuration"
          },
          "413": {
            "description": "Report exceeds 1 MiB"
          },
          "422": {
            "description": "Unsupported or malformed SARIF/input"
          },
          "204": {
            "description": "Configured; prior evidence invalidated"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "scanner",
                  "workflow",
                  "require_scan",
                  "minimum_severity"
                ],
                "properties": {
                  "scanner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "workflow": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "require_scan": {
                    "type": "boolean"
                  },
                  "minimum_severity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  }
                }
              }
            }
          }
        }
      }
    },
    "/repos/{owner}/{repo}/security/scans": {
      "get": {
        "operationId": "securityScans",
        "summary": "List the newest 100 scan attempts",
        "tags": [
          "Security"
        ],
        "description": "Repository writers only; hidden findings return 404. Mutations require repository administration and an unrestricted admin-scope token. Scan initiation/completion also accepts live task tokens from the explicitly configured trusted default-branch workflow.",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requested evidence"
          },
          "403": {
            "description": "Insufficient upload or administration authority"
          },
          "404": {
            "description": "Repository or security evidence is not visible"
          },
          "409": {
            "description": "Already completed, retention limit or changed configuration"
          },
          "413": {
            "description": "Report exceeds 1 MiB"
          },
          "422": {
            "description": "Unsupported or malformed SARIF/input"
          }
        }
      },
      "post": {
        "operationId": "beginSecurityScan",
        "summary": "Begin a pending scan for an immutable commit",
        "tags": [
          "Security"
        ],
        "description": "Repository writers only; hidden findings return 404. Mutations require repository administration and an unrestricted admin-scope token. Scan initiation/completion also accepts live task tokens from the explicitly configured trusted default-branch workflow.",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requested evidence"
          },
          "403": {
            "description": "Insufficient upload or administration authority"
          },
          "404": {
            "description": "Repository or security evidence is not visible"
          },
          "409": {
            "description": "Already completed, retention limit or changed configuration"
          },
          "413": {
            "description": "Report exceeds 1 MiB"
          },
          "422": {
            "description": "Unsupported or malformed SARIF/input"
          },
          "201": {
            "description": "Pending scan with server-generated id"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "commit_sha"
                ],
                "properties": {
                  "commit_sha": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{40}([a-fA-F0-9]{24})?$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/repos/{owner}/{repo}/security/scans/{id}/sarif": {
      "post": {
        "operationId": "finishSecurityScan",
        "summary": "Complete this scan once using bounded SARIF",
        "tags": [
          "Security"
        ],
        "description": "Repository writers only; hidden findings return 404. Mutations require repository administration and an unrestricted admin-scope token. Scan initiation/completion also accepts live task tokens from the explicitly configured trusted default-branch workflow.",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requested evidence"
          },
          "403": {
            "description": "Insufficient upload or administration authority"
          },
          "404": {
            "description": "Repository or security evidence is not visible"
          },
          "409": {
            "description": "Already completed, retention limit or changed configuration"
          },
          "413": {
            "description": "Report exceeds 1 MiB"
          },
          "422": {
            "description": "Unsupported or malformed SARIF/input"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/sarif+json": {
              "schema": {
                "type": "object",
                "description": "SARIF 2.1.0, exactly one run, explicit invocations/results, at most 1000 findings; local repository paths only. Successful invocations without error notifications are complete."
              }
            }
          }
        }
      }
    },
    "/repos/{owner}/{repo}/security/scans/{id}/findings": {
      "get": {
        "operationId": "securityFindings",
